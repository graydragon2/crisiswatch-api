{
  "name": "crisiswatch-api",
  "version": "1.0.0",
  "description": "Backend for CrisisWatch",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "sh -c 'if [ -n \"$DATABASE_URL\" ]; then npx prisma migrate deploy --config prisma.migrate.config.js || echo \"Migration failed — starting anyway; auth routes will error until this is fixed\"; fi; node server.js'",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev --config prisma.migrate.config.js",
    "db:studio": "prisma studio --config prisma.migrate.config.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "node-fetch": "^3.3.2",
    "prisma": "^7.9.1",
    "resend": "^6.20.0",
    "rss-parser": "^3.13.0"
  }
}
