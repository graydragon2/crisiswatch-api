PORT=3001

# Required for /api/score and /api/threats?useAI=true
ANTHROPIC_API_KEY=

# Required for /api/darkweb
LEAKCHECK_API_KEY=

# Optional override (defaults to claude-haiku-4-5-20251001)
# THREAT_SCORER_MODEL=claude-haiku-4-5-20251001

# Required for email alerts. Use a Gmail account + an App Password (not your
# regular password) — generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the account).
SMTP_USER=
SMTP_PASS=

# Optional overrides
# ALERT_SCORE_THRESHOLD=8
# ALERT_CHECK_INTERVAL_MINUTES=15
