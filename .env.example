PORT=3001

# Required for magic-link auth (/api/auth/*). Managed Postgres — see
# prisma/schema.prisma for the schema, `npm run db:migrate` to apply it
# locally against a real database.
DATABASE_URL=

# Required for magic-link auth — signs/verifies session JWTs. Generate a
# real random value for production (e.g. `openssl rand -hex 32`); never
# commit an actual secret here.
JWT_SECRET=

# Used to build the link embedded in magic-link emails. Defaults to
# http://localhost:3000 if unset.
# FRONTEND_URL=https://app.contingencybrief.com

# Required for /api/score, /api/threats?useAI=true, and /api/phishing/analyze
ANTHROPIC_API_KEY=

# Required for /api/darkweb and persistent dark-web monitoring
LEAKCHECK_API_KEY=

# Optional override (defaults to claude-haiku-4-5-20251001)
# THREAT_SCORER_MODEL=claude-haiku-4-5-20251001

# Required for email alerts. Use a Gmail account + an App Password (not your
# regular password) — generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the account).
SMTP_USER=
SMTP_PASS=

# Optional overrides
# ALERT_SCORE_THRESHOLD=8
# MONITOR_INTERVAL_MINUTES=15   # how often to check for alerts AND record a Threat Score history snapshot
# DARKWEB_RECHECK_HOURS=24      # how often to re-check monitored emails (independent of MONITOR_INTERVAL_MINUTES — breach data doesn't change minute to minute)
